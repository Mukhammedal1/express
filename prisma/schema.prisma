generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  is_active Boolean  @default(false)
  verification  String?
  refresh_token String?
  createdAt DateTime @default(now())

  tasks     Task[]
  @@index([verification, is_active])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}